# Copy this to .env and adjust as needed.

# LLM provider: "bedrock" (real Amazon Bedrock) or "mock" (no AWS needed, deterministic demo).
LLM_PROVIDER=mock

# AWS / Bedrock settings (only used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
# Claude Sonnet 4.5 via cross-region inference profile (note the "us." prefix).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional: enable Amazon Bedrock Guardrails (managed content safety).
# Leave blank to skip. Requires a guardrail created in your AWS account.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Minimum confidence for a rule to be accepted without being flagged for review.
CONFIDENCE_THRESHOLD=0.6
